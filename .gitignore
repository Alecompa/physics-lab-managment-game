# Godot editor cache and local exports
.godot/
exports/

# OS metadata and logs
.DS_Store
*.log

# Temporary test saves, including interrupted atomic writes
tests/.test_*
tests/.ui_test_*

# Generated UI captures and previous iteration reference images
